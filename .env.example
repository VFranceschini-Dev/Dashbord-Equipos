# --- Frontend (Vite, expuestos al navegador) ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Variables del SERVIDOR (funciones api/usuarios y api/users de Vercel). Sin prefijo VITE_ ---
# La API key de Metabase SOLO vive acá (Vercel > Settings > Environment Variables).
# Se acepta como METABASE_API_KEY (nombre pedido) o IPA_API_KEY (alias).
# El navegador nunca habla con ipa.donnet.com.ar ni ve esta key. Nunca comitear valores reales.
IPA_API_URL=https://ipa.donnet.com.ar
METABASE_API_KEY=
IPA_API_KEY=
IPA_DB_ID=5
IPA_USUARIOS_TABLE_ID=1406
SUPABASE_URL=
SUPABASE_ANON_KEY=
