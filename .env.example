# --- Frontend (Vite, expuestos al navegador) ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Variables del SERVIDOR (función api/usuarios de Vercel). Sin prefijo VITE_: nunca llegan al navegador ---
# Credenciales y nombres de bases/tablas SOLO se usan en el backend.
# La API key de Metabase vive acá (Vercel > Settings > Environment Variables). Nunca comitear valores reales.
IPA_API_URL=https://ipa.donnet.com.ar
IPA_API_KEY=
METABASE_API_KEY=
IPA_DB_ID=5
IPA_USUARIOS_TABLE_ID=1406
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Fuente de respaldo de usuarios (tabla propia, lectura solo desde el servidor):
SUPABASE_SERVICE_ROLE_KEY=
USERS_FALLBACK_TABLE=Users_Nuevos
