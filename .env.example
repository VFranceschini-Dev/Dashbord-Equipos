VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Proxy interno de Metabase (SAI_TEST, solo lectura). Default si se omite:
# https://ipa.donnet.com.ar/api — NO poner la API key acá ni con prefijo VITE_.
VITE_METABASE_PROXY_URL=https://ipa.donnet.com.ar/api

# --- Variables del SERVIDOR (funciones api/* de Vercel). Sin prefijo VITE_ ---
# Estas SOLO viven en Vercel > Settings > Environment Variables (y en .env local
# para `vercel dev`). Nunca se comitean valores reales.
IPA_API_URL=
IPA_API_KEY=
IPA_DB_ID=
IPA_USUARIOS_TABLE_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_METABASE_TIMEOUT_MS=15000
