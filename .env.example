# --- Variables del FRONTEND (Vite, quedan visibles en el bundle) ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Variables del SERVIDOR (función api/usuarios.ts de Vercel) ---
# Estas SOLO viven en Vercel > Settings > Environment Variables (y en .env.local
# para probar en local / correr npm run test:ipa). Nunca se comitean valores reales.
# La API key del origen interno NUNCA lleva prefijo VITE_ ni llega al navegador.
IPA_API_URL=https://ipa.donnet.com.ar
IPA_API_KEY=
IPA_DB_ID=5
IPA_USUARIOS_TABLE_ID=1406
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clave service_role: la usa SOLO la función serverless para dar de alta
# usuarios en la tabla gestionada por la app. Nunca la clave service_role
# con prefijo VITE_ ni expuesta al navegador.
SUPABASE_SERVICE_ROLE_KEY=
USERS_NEW_TABLE=users_new
USERS_FALLBACK_TABLE=Users_Nuevos