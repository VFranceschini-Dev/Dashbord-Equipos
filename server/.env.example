# Servidor HTTP (NUNCA usar puerto 3000: Vite lo ocupa en desarrollo)
PORT=4000

# --- Metabase (SOLO lectura; API key sin prefijo VITE, nunca llega al navegador) ---
METABASE_URL=http://10.0.0.8:3000
METABASE_API_KEY=pegá_acá_tu_api_key_actual
METABASE_DB_ID=5
METABASE_TIMEOUT_MS=15000

# Tabla de usuarios en SAI_TEST (source-table id observado en Metabase)
SAI_USUARIOS_TABLE_ID=1406

# Paginación de /api/dataset (límite duro de Metabase: 2000 filas por request)
METABASE_PAGE_SIZE=2000

# Camino alternativo opcional: pregunta guardada en Metabase para leer más de 2000 filas
# (POST /api/card/{id}/query/json). Dejar vacío para usar paginación por offset.
METABASE_CARD_ID=

# CORS: origen(es) permitidos separados por coma (URL del frontend)
ALLOWED_ORIGINS=http://localhost:3000

# TTL de la caché de usuarios (ms). Default: 5 minutos.
USERS_CACHE_TTL_MS=300000