# ============================================================
# Servidor MCP — Puente Metabase ⇄ Mesh
# Copia este archivo como .env y completa los valores REALES.
# NUNCA subas el archivo .env al repositorio (está en .gitignore).
# ============================================================

# Puerto HTTP donde expone el transporte SSE
PORT=3000

# ---------- METABASE ----------
# URL base SIN barra final, ej: https://metabase.midominio.com
METABASE_URL=https://metabase.tu-dominio.com
# API Key de Metabase (Administrador > Parámetros de aplicación > Claves de API)
# Se envía en el header x-api-key. Si usas Session Token en su lugar,
# ajusta el header en src/services/metabase.service.ts
METABASE_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- MESH ----------
# URL base de la API de Mesh SIN barra final
MESH_URL=https://mesh.tu-dominio.com
# API Key de Mesh (se envía como Authorization: Bearer <key>)
MESH_API_KEY=sk_tu_api_key_de_mesh

# ---------- OPCIONAL ----------
# Timeout de peticiones a servicios externos en ms (por defecto 30000)
REQUEST_TIMEOUT_MS=30000
